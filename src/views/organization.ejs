<%- include('partials/header') %>

<main>
  <section class="page-section organization-detail">
    <%- include('partials/page-kicker') %>

    <h1><%= title %></h1>

    <div class="organization-hero">
      <img
        class="organization-detail-logo"
        src="/images/<%= organizationDetails.logo_filename %>"
        alt="<%= organizationDetails.name %> logo"
      />

      <div class="organization-detail-content">
        <h2><%= organizationDetails.name %></h2>

        <p class="organization-description">
          <%= organizationDetails.description %>
        </p>
      </div>
    </div>

    <div class="detail-section">
      <h3>Service Projects</h3>

      <ul class="content-list">
        <% projects.forEach(project => { %>
        <li class="content-card category-card">
          <span class="li-dot"></span>

          <h3 class="li-title">
            <a href="/project/<%= project.project_id %>">
              <%= project.title %>
            </a>
          </h3>
        </li>
        <% }) %>
      </ul>
    </div>
    <% if (user && user.role_name === 'admin') { %>
    <div class="page-actions">
      <a
        href="/edit-organization/<%= organizationDetails.organization_id %>"
        class="primary-button"
      >
        Update Organization
      </a>
    </div>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
