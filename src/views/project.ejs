<%- include('partials/header') %>

<main>
  <section class="page-section">
    <%- include('partials/page-kicker') %>

    <div class="project-detail">
      <h2><%= project.title %></h2>

      <p class="project-detail-description"><%= project.description %></p>

      <div class="project-detail-meta">
        <p>
          <strong>Date:</strong>
          <%= new Date(project.project_date).toLocaleDateString("en-US", {
            month: "long",
            day: "numeric",
            year: "numeric"
          }) %>
        </p>

        <p>
          <strong>Location:</strong>
          <%= project.location %>
        </p>

        <p>
          <strong>Partner Organization:</strong>

          <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
          </a>
        </p>
      </div>

      <div class="detail-section">
        <h3>Categories</h3>

        <ul class="content-list">
          <% categories.forEach(category => { %>
          <li class="content-card category-card">
            <span class="li-dot"></span>

            <h3 class="li-title">
              <a href="/category/<%= category.category_id %>">
                <%= category.name %>
              </a>
            </h3>
          </li>
          <% }) %>
        </ul>
      </div>
    </div>
    <% if (user) { %>

    <% if (isVolunteer) { %>
    <p class="volunteer-message">✅ You are volunteering for this project.</p>
    <% } %>

    <div class="page-actions">
      <% if (!isVolunteer) { %>

      <form action="/project/<%= project.project_id %>/volunteer" method="POST">
        <button type="submit" class="primary-button">
          ❤️ Volunteer for this Project
        </button>
      </form>

      <% } else { %>

      <form
        action="/project/<%= project.project_id %>/unvolunteer"
        method="POST"
      >
        <button type="submit" class="primary-button">
          🗑 Remove Volunteer Registration
        </button>
      </form>

      <% } %>

      <% if (user.role_name === 'admin') { %>

      <a href="/edit-project/<%= project.project_id %>" class="primary-button">
        Edit Project
      </a>

      <a
        href="/assign-categories/<%= project.project_id %>"
        class="primary-button"
      >
        Edit Categories
      </a>

      <% } %>
    </div>

    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
