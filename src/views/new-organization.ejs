<%- include('partials/header') %>
<main>
  <section class="page-section">
    <%- include('partials/page-kicker') %>
    <h1><%= title %></h1>

    <p>Create a new partner organization.</p>

    <form class="form" action="/new-organization" method="POST">
      <div class="form-group">
        <label class="form-label" for="name"> Organization Name </label>
        <input class="form-control" type="text" id="name" name="name" />
      </div>

      <div class="form-group">
        <label class="form-label" for="description"> Description </label>
        <textarea
          class="form-control"
          id="description"
          name="description"
        ></textarea>
      </div>

      <div class="form-group">
        <label class="form-label" for="contactEmail"> Contact Email </label>
        <input
          class="form-control"
          type="email"
          id="contactEmail"
          name="contactEmail"
        />
      </div>

      <button type="submit" class="primary-button">Create Organization</button>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
