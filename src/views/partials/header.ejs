<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script src="/js/main.js" defer></script>
    <link rel="stylesheet" href="/css/main.css" />
  </head>
  <body>
    <header>
      <nav class="navbar">
        <div class="logo">
          <a href="/"
            ><img
              src="/images/cse340-service-network.png"
              alt="CSE 340 Service Network logo"
          /></a>
        </div>
        <button class="menu-toggle" aria-label="Toggle navigation">☰</button>
        <ul class="nav-links">
          <li>
            <a href="/" class="<%= currentRoute === '/' ? 'active' : '' %>">
              Home
            </a>
          </li>

          <li>
            <a
              href="/organizations"
              class="<%= currentRoute.startsWith('/org') ? 'active' : '' %>"
            >
              Organizations
            </a>
          </li>

          <li>
            <a
              href="/projects"
              class="<%= currentRoute.startsWith('/pro') ? 'active' : '' %>"
            >
              Projects
            </a>
          </li>

          <li>
            <a
              href="/categories"
              class="<%= currentRoute.startsWith('/cat') ? 'active' : '' %>"
            >
              Categories
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <% const messages = flash(); %>
    <div class="flash-container">
      <% Object.keys(messages).forEach(type => { %> <%
      messages[type].forEach(msg => { %>
      <div class="alert <%= type %>">
        <div class="flash-title">
          <%= type.charAt(0).toUpperCase() + type.slice(1) %>
        </div>
        <p class="flash-message"><%= msg %></p>
      </div>
      <% }); %>
      <% }); %>
    </div>