<%- include('partials/header') %>
<main>
  <section class="page-section">
    <%- include('partials/page-kicker') %>
    <h1><%= title %></h1>

    <p>Here are a few of our partner organizations.</p>

    <ul class="content-list organization-list">
      <% organizations.forEach(organization => { %>
      <li class="content-card">
        <img
          src="/images/<%= organization.logo_filename %>"
          alt="<%= organization.name %> logo"
        />

        <div class="organization-content">
          <h2 class="li-title">
            <a href="/organization/<%= organization.organization_id %>">
              <%= organization.name %>
            </a>
          </h2>

          <% if (organization.description) { %>
          <p class="li-description"><%= organization.description %></p>
          <% } %>

          <p class="organization-email">
            <a href="mailto:<%= organization.contact_email %>">
              <%= organization.contact_email %>
            </a>
          </p>
        </div>
      </li>
      <% }); %>
    </ul>
  </section>
</main>
<%- include('partials/footer') %>
